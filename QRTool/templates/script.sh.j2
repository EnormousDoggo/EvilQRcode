#!/bin/bash

# Couleurs
GREEN='\e[32m'; YELLOW='\e[33m'; RED='\e[31m'; NC='\e[0m'

# Vérif des dépendances
for cmd in dig whois curl openssl whatweb wafw00f jq; do
  command -v "$cmd" >/dev/null 2>&1 || { echo -e "${RED}❌ $cmd manquant${NC}"; exit 1; }
done

# cURL rate limit for PhishStats if abused
API_URL="https://phishstats.info:2096/api/search/phishing-websites?keyword=$DOMAIN"

RAW_URL=$1
DOMAIN=$(echo "$RAW_URL" | sed -E 's~https?://(www\.)?~~' | cut -d/ -f1)
IP=$(dig +short "$DOMAIN" | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n1)

echo -e "${GREEN}🔍 Analyse de $RAW_URL${NC}"
echo "--------------------------------------"

# WHOIS
echo -e "${YELLOW}📄 WHOIS${NC}"
WHOIS_RAW=$(whois "$DOMAIN")
echo "$WHOIS_RAW" | grep -Ei 'Registrar(?! Abuse| WHOIS)|Creation Date|Expiry Date|Registrant (Organization|Country)' | sort -u || echo "🔴 WHOIS impossible"

# DNS
echo -e "\n${YELLOW}📡 DNS${NC}"
dig +short "$DOMAIN"

# GEO-IP
echo -e "\n${YELLOW}🌍 GEO-IP${NC}"
IPINFO=$(curl -s ipinfo.io/$IP)
echo "$IPINFO" | jq -r '.ip, .country, .org'

# PING
echo -e "\n${YELLOW}📶 PING${NC}"
ping -c 2 "$DOMAIN" | tail -2

# SSL
echo -e "\n${YELLOW}🔐 SSL${NC}"
echo | openssl s_client -servername "$DOMAIN" -connect "$DOMAIN:443" 2>/dev/null \
  | openssl x509 -noout -dates -issuer -subject || echo "🔴 pas SSL"

# Techno
echo -e "\n${YELLOW}🧠 Technologies${NC}"
whatweb "$RAW_URL"

# WAF
echo -e "\n${YELLOW}🧱 WAF${NC}"
if wafw00f "$RAW_URL" 2>/dev/null | grep -q "is behind"; then
  echo "✅ présent"
else
  echo "⚠️ absent ou indétectable"
fi

# HTTP headers
echo -e "\n${YELLOW}📦 en-têtes HTTP${NC}"
curl -sI "$RAW_URL" | grep -E '^HTTP/|Server|Location|Content-Type'

# 🔐 Phishing check (PhishStats)
echo -e "\n${YELLOW}🚨 Phishing (PhishStats)${NC}"
PHISH=$(curl -s "$API_URL" | jq '. | length')
if [ "$PHISH" -gt 0 ]; then
  echo -e "${RED}❌ Présent dans la base PhishStats ($PHISH incidents)${NC}"
  PHISH_FLAG=1
else
  echo -e "${GREEN}✅ non repéré${NC}"
  PHISH_FLAG=0
fi

echo "--------------------------------------"
echo -e "${YELLOW}🧠 Calcul du score${NC}"

SCORE=0; MAX=6

# 1. Domaine > 1 an
YEAR=$(whois "$DOMAIN" | grep -i 'Creation Date' | head -1 | grep -oE '[0-9]{4}')
if [ -n "$YEAR" ] && [ $(( $(date +%Y) - YEAR )) -ge 1 ]; then
    echo "✅ Domaine ancien"
    ((SCORE++))
else
    echo "⚠️ Domaine récent"
fi

# 2. SSL présent
openssl s_client -servername "$DOMAIN" -connect "$DOMAIN:443" </dev/null 2>/dev/null | openssl x509 -noout -dates | grep -q notAfter \
  && { echo "✅ SSL"; ((SCORE++)); } || echo "⚠️ pas de SSL"

# 3. Techno connue
whatweb "$RAW_URL" | grep -iqE "WordPress|Apache|Nginx|Cloudflare" \
  && { echo "✅ techno reconnue"; ((SCORE++)); } || echo "⚠️ Pas de techno reconnue"

# 4. WAF
[ "$(wafw00f "$RAW_URL" 2>/dev/null | grep -c 'is behind')" -gt 0 ] \
  && { echo "✅ WAF"; ((SCORE++)); } || echo "⚠️ pas de WAF"

# 5. Phishing
[ "$PHISH_FLAG" -eq 0 ] && { echo "✅ non listé phishing"; ((SCORE++)); } || echo "❌ listé phishing"

# 6. Pays fiable / risqué
COUNTRY=$(echo "$IPINFO" | jq -r '.country')
case "$COUNTRY" in
  FR|DE|US|BE|NL|CH|CA|UK) echo "✅ pays fiable ($COUNTRY)"; ((SCORE++)); ;;
  *) echo "⚠️ pays risqué ($COUNTRY)"; ;;
esac

echo "--------------------------------------"
echo -e "${YELLOW}📊 Score final: $SCORE / $MAX${NC}"

if [ "$SCORE" -ge 5 ]; then
  echo -e "${GREEN}✅ SITE FIABLE${NC}"
elif [ "$SCORE" -ge 3 ]; then
  echo -e "${YELLOW}⚠️ POTENTIELLEMENT RISQUÉ${NC}"
else
  echo -e "${RED}❌ SITE SUSPECT${NC}"
fi